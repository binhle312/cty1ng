# Copy to .env and fill in. Never commit .env (security.md §2.6).
# Every variable is documented in docs/architecture.md §8.

# Database, workspaces, avatars.
DATA_DIR=./data
# Must stay loopback in phase 1: 127.0.0.1 or localhost. Startup refuses anything else.
HOST=127.0.0.1
PORT=8000
# Dev frontend origins; the production build is same-origin.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Runs and limits.
MAX_CONCURRENT_RUNS=3
RUN_LEASE_SECONDS=900
RUN_MAX_ATTEMPTS=3
RUN_STALL_SECONDS=600
MODEL_REQUEST_TIMEOUT_SECONDS=300
RUNS_PER_CONVERSATION_PER_HOUR=50

# App behaviour: dev | test | prod. Not the same as NODE_ENV (architecture.md §8).
APP_ENV=dev
# 1 wires the fake model and the fake:scripted catalog entry (testing.md §2).
FAKE_MODEL=0
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Provider keys, named by config/models.yaml (from M2). Set only the ones you use.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
