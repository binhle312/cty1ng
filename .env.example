# Copy to .env and fill in what you need (docs/architecture.md §8). Every value below is the
# default; a line you leave out takes the default too. Never commit .env.

# Database, Libraries, run worktrees, avatars. A relative path is from the repository root.
DATA_DIR=./data
# Loopback only: the app has no login yet (docs/security.md §2.1).
HOST=127.0.0.1
PORT=8000
# The dev frontend. The app's own origin (http://127.0.0.1:PORT) is always allowed.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# dev, test or prod. Test routes exist only with test; never with NODE_ENV=production.
APP_ENV=dev
# 1 wires the fake model and the `fake:scripted` catalog entry (docs/testing.md §2).
FAKE_MODEL=0
# fatal, error, warn, info, debug, trace or silent
LOG_LEVEL=info

# Runs (used from M3)
MAX_CONCURRENT_RUNS=3
RUN_LEASE_SECONDS=900
RUN_MAX_ATTEMPTS=3
RUN_STALL_SECONDS=600
MODEL_REQUEST_TIMEOUT_SECONDS=300
TITLE_REQUEST_TIMEOUT_SECONDS=20
PURGE_INTERVAL_HOURS=24

# Provider keys: the names config/models.yaml refers to (from M3). Never logged or returned.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
