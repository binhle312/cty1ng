{
  "name": "@cty1ng/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/app/main.ts",
    "start": "tsx --env-file-if-exists=../.env src/app/main.ts",
    "cli": "tsx --env-file-if-exists=../.env src/app/cli.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../.env src/app/cli.ts db migrate",
    "db:check": "drizzle-kit check && tsx ../scripts/db-check.ts"
  },
  "dependencies": {
    "@cty1ng/shared": "workspace:*",
    "@hono/node-server": "2.1.5",
    "@hono/zod-openapi": "1.6.3",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "pino": "10.4.0",
    "typeid-js": "1.2.0",
    "uuidv7": "1.2.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "drizzle-kit": "0.31.11",
    "pino-pretty": "13.2.0"
  }
}
