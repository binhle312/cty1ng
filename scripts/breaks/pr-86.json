        "file": "frontend/test/e2e/bots.spec.ts",
        "name": "the wheel and a sideways touchpad motion scroll a long roster"
      },
      "assertion": "await expect.poll(left).toBeGreaterThan(0);\n  expect(await pageScroll()).toEqual([0, 0, 0]);\n\n",
      "breaks": [
