          "file": "frontend/src/features/shell/header-roster.tsx",
          "edits": [
            {
              "find": "        onWheel={(event) => {\n          // The wheel scrolls sideways (state 3).\n          if (event.deltaX === 0 && event.deltaY !== 0)\n            event.currentTarget.scrollLeft += event.deltaY;\n        }}\n",
              "replace": ""
            }
          ]
        }
