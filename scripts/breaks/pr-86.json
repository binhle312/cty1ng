{
  "claims": [
    {
      "id": "R8-live",
      "claim": "A skill restore pins the skill to no live bot (invariant 21)",
      "test": {
        "kind": "vitest",
        "file": "backend/src/core/bots/bots.service.test.ts",
        "name": "restore assigns the skill to no bot, live or in Trash"
      },
      "assertion": "expect((await backend.bots.get(liveId)).pins).toEqual([]);",
      "breaks": [
        {
          "id": "R8-live-a",
          "file": "backend/src/core/skills/skills.service.ts",
          "edits": [
            {
              "find": "          if (bot !== null && bot.deletedAt === null) suggestedBotIds.push(bot.id);\n",
              "replace": "          if (bot !== null && bot.deletedAt === null) suggestedBotIds.push(bot.id);\n          if (bot !== null) {\n            const v = await tx.skills.latestVersion(id);\n            if (v !== null) await tx.bots.upsertPin({ botId: bot.id, skillId: id, skillVersionId: v.id, alwaysLoad: false, addedAt: clock.now(), updatedAt: clock.now() });\n          }\n"
            }
          ]
        }
      ]
    },
    {
      "id": "R8-trash",
      "claim": "A bot that leaves Trash after a skill restore has no pin of the skill (invariant 21)",
      "test": {
        "kind": "vitest",
        "file": "backend/src/core/bots/bots.service.test.ts",
        "name": "restore assigns the skill to no bot, live or in Trash"
      },
      "assertion": "expect((await backend.bots.restoreBySlug(gone.slug)).pins).toEqual([]);",
      "breaks": [
        {
          "id": "R8-trash-a",
          "file": "backend/src/core/skills/skills.service.ts",
          "edits": [
            {
              "find": "          if (bot !== null && bot.deletedAt === null) suggestedBotIds.push(bot.id);\n",
              "replace": "          if (bot !== null && bot.deletedAt === null) suggestedBotIds.push(bot.id);\n          if (bot !== null && bot.deletedAt !== null) {\n            const v = await tx.skills.latestVersion(id);\n            if (v !== null) await tx.bots.upsertPin({ botId: bot.id, skillId: id, skillVersionId: v.id, alwaysLoad: false, addedAt: clock.now(), updatedAt: clock.now() });\n          }\n"
            }
          ]
        }
      ]
    },
    {
