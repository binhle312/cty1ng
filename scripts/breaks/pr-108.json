      "test": {
        "kind": "vitest",
        "file": "backend/test/security/secrets.test.ts",
        "name": "never appear in an answer, in the stream frames, or in the log"
      },
      "assertion": "for (const text of [...texts, ...backend.lines]) expect(text).not.toContain(\"SENTINEL\");",
      "breaks": [
        {
          "id": "R9-read-tools",
          "file": "backend/src/adapters/http/routes/catalog.ts",
          "edits": [
            {
              "find": "c.json([...catalog.tools], 200)",
              "replace": "c.json([...catalog.tools, { leaked: \"sk-test-SENTINEL-4f9a2c71e0b3\" }] as never, 200)"
            }
          ]
        },
        {
          "id": "R9-read-tools-header",
          "file": "backend/src/adapters/http/routes/catalog.ts",
          "edits": [
            {
              "find": "    .openapi(listTools, (c) => c.json([...catalog.tools], 200));",
              "replace": "    .openapi(listTools, (c) => {\n      c.header(\"x-debug-key\", \"sk-test-SENTINEL-4f9a2c71e0b3\");\n      return c.json([...catalog.tools], 200);\n    });"
            }
          ]
        }
      ]
