{
  "claims": [
    {
      "id": "W1",
      "claim": "After Create, the bot Create page does not move or show its toast before the newest bot list came",
      "test": {
        "kind": "vitest",
        "file": "frontend/src/features/bots/create-bot-page.test.tsx",
        "name": "stays on the Create page until the newest bot list comes"
      },
      "assertion": "expect(screen.queryByText(\"Created BA ✨\"), \"before the newest list\").toBeNull();",
      "breaks": [
        {
          "id": "W1-a",
          "file": "frontend/src/features/bots/create-bot-page.tsx",
          "edits": [
            {
              "find": "        await queryClient.invalidateQueries({ predicate: PIN_QUERIES });\n",
              "replace": "        void queryClient.invalidateQueries({ predicate: PIN_QUERIES });\n"
            }
          ]
        }
      ]
    },
    {
      "id": "W2",
      "claim": "After Create, the new skill page does not move before the newest skill list came",
      "test": {
        "kind": "vitest",
        "file": "frontend/src/features/skills/skill-page.test.tsx",
        "name": "stays on the Create page until the newest list comes"
      },
      "assertion": "expect(router.state.location.pathname, \"before the newest list\").toBe(\"/skills/new\");",
      "breaks": [
        {
          "id": "W2-a",
          "file": "frontend/src/features/skills/new-skill-page.tsx",
          "edits": [
            {
              "find": "      await queryClient.invalidateQueries({ queryKey: allSkillsOptions().queryKey });\n",
              "replace": "      void queryClient.invalidateQueries({ queryKey: allSkillsOptions().queryKey });\n"
            }
          ]
        }
      ]
    },
