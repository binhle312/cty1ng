# Copy to .env and fill in. Never commit .env.

# Your own user id on each chat platform you use. Only you can give orders and press approvals.
# Discord: Developer Mode -> right-click yourself -> Copy User ID.
OWNER_DISCORD_ID=

# One Discord application per bot. The variable name is set in bots/<role>/bot.yaml.
DISCORD_TOKEN_BA=
DISCORD_TOKEN_DESIGNER=

# Model provider keys. Set only the ones your bots' `model:` strings use.
# bot.yaml `model:` is "<provider>:<model name>", e.g. anthropic:claude-sonnet-5-5 or deepseek:deepseek-chat
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Text channels whose name starts with this prefix are treated as projects.
PROJECT_CHANNEL_PREFIX=project-

# Where state lives. Each project channel gets workspaces/<channel_id>/ (its own git repo).
DATA_DIR=./data

# Optional tuning
JOB_LEASE_SECONDS=900
JOB_MAX_ATTEMPTS=3
WORKER_POLL_SECONDS=1.0
